-- Moves to the NPC and sells briefcases
tab:CreateButton({
    name = "Sell Briefcases",
    callback = function()
        local char = lp.Character or lp.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart")
        local cam = workspace.CurrentCamera

        local changedParts = {}

        local function fire(prox)
            local camHeight = 50
            cam.CFrame = CFrame.new(root.Position + Vector3.new(0, camHeight, 0), root.Position)
            fireproximityprompt(prox)
        end

        local function disableWallCollisions()
            for _, part in pairs(workspace:GetDescendants()) do
                if part:IsA("BasePart") and part.Position.Y > 0 and part.CanCollide then
                    part.CanCollide = false
                    table.insert(changedParts, part)
                end
            end
        end

        local function enableCollisions()
            for _, part in ipairs(changedParts) do
                if part and part.Parent then
                    part.CanCollide = true
                end
            end
        end

        local success, err = pcall(function()
            disableWallCollisions()

            -- Spam TP 3 times and fire Exit prompt
            local firstPos = Vector3.new(-712, -34, -498)
            local exitProx = workspace.clickdoors.litcutz.litcutsleave.Exit
            for i = 1, 3 do
                root.CFrame = CFrame.new(firstPos)
                fire(exitProx)
                task.wait(0.1)
            end

            task.wait(2)

            -- Move toward target in 2-stud increments
            local targetPos = Vector3.new(-780, 3, -396)
            while (root.Position - targetPos).Magnitude > 2 do
                local dir = (targetPos - root.Position).Unit
                root.CFrame = root.CFrame + dir * 2
                task.wait(0.05)
            end

            task.wait(1)

            fire(workspace.ManufactureSeller1.SellToggle)
        end)

        enableCollisions()

        if not success then
            warn("Error during Sell Briefcases:", err)
        end
    end,
})

