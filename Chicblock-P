local mobileGui, mobileButton
local mobileLockOn = false
local mobileTriggerOn = false
local mobileConn

local function getClosestToCenter()
    local closest, shortest = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function getPlayerInFront()
    local closest, bestDot = nil, 0.99
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dir = (root.Position - Camera.CFrame.Position).Unit
                local dot = Camera.CFrame.LookVector:Dot(dir)
                if dot > bestDot then
                    bestDot = dot
                    closest = player
                end
            end
        end
    end
    return closest
end

local function startMobileLoop()
    if mobileConn then return end
    mobileConn = RunService.RenderStepped:Connect(function()
        Camera = workspace.CurrentCamera

        if mobileLockOn then
            local target = getClosestToCenter()
            if target then
                local root = target.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, root.Position)
                end
            end
        end

        if mobileTriggerOn and getPlayerInFront() then
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
        end
    end)
end

local function stopMobileLoopIfIdle()
    if mobileConn and not mobileGui and not mobileTriggerOn then
        mobileConn:Disconnect()
        mobileConn = nil
    end
end

