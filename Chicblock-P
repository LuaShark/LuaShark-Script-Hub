local hitboxSize = 6.5
local hitboxTransparency = 0.8

local function createFakeHitbox(character)
    if not character then return end

    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
    if not torso then return end

    local existingHitbox = character:FindFirstChild("FakeHitbox")

    if not existingHitbox then
        local fakeHitbox = Instance.new("Part")
        fakeHitbox.Name = "FakeHitbox"
        fakeHitbox.Parent = character
        fakeHitbox.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
        fakeHitbox.Transparency = hitboxTransparency
        fakeHitbox.Material = Enum.Material.ForceField
        fakeHitbox.Color = Color3.new(1, 1, 1)
        fakeHitbox.CanCollide = false
        fakeHitbox.CanQuery = true
        fakeHitbox.CanTouch = true
        fakeHitbox.Massless = true
        fakeHitbox.Anchored = false

        local motor = Instance.new("Motor6D")
        motor.Part0 = torso
        motor.Part1 = fakeHitbox
        motor.C0 = CFrame.new()
        motor.Parent = fakeHitbox
    else
        existingHitbox.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
        existingHitbox.Transparency = hitboxTransparency
    end
end

local function scanForCharacters()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            createFakeHitbox(player.Character)
        end
    end
end

local function removeHitboxes()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hb = player.Character:FindFirstChild("FakeHitbox")
            if hb then hb:Destroy() end
        end
    end
end

